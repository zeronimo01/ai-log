# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요.
# .env 는 GitHub에 올라가지 않습니다(.gitignore). 절대 공개하지 마세요.

# Supabase 프로젝트 주소. 대시보드 주소를 그대로 넣어도 됩니다.
#   예) https://abcdefghijklmnopqrst.supabase.co
#   예) https://supabase.com/dashboard/project/abcdefghijklmnopqrst
SUPABASE_URL=

# Supabase 대시보드 > Project Settings > API Keys > Secret keys 의 sb_secret_... 키
SUPABASE_SECRET_KEY=

# 두 값을 비워두면 Supabase 대신 이 폴더의 ailog.db(SQLite)에 저장합니다.
